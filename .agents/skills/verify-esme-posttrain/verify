ROOT = Path(__file__).resolve().parents[3]
PYTHON = ROOT / ".venv" / "bin" / "python"
GLOBAL_PATHS = [
    "pyproject.toml",
    "uv.lock",
    "fixtures/tiny_bundle/*",
    ".agents/skills/verify-esme-posttrain/*",
]
TRIPWIRE_TOOLS = ("modal", "wandb", "huggingface-cli", "hf")
SECRET_MARKERS = ("KEY", "TOKEN", "SECRET", "PASSWORD")
SITECUSTOMIZE = """
import os, socket
_log = os.environ["VERIFY_TRIPWIRE_LOG"]
_connect = socket.socket.connect
def _guard(self, address):
    host = address[0] if isinstance(address, tuple) else "unix"
    if host not in ("127.0.0.1", "::1", "localhost", "unix"):
        with open(_log, "a") as log:
            log.write(f"socket.connect {address!r}\\n")
        raise OSError(f"verify tripwire: network connect to {address!r} refused")
    return _connect(self, address)
socket.socket.connect = _guard
"""
# Calls a script's @app.local_entrypoint body with the argv `modal run` would pass, without the modal CLI.
ENTRYPOINT = """
import importlib, sys
mod = importlib.import_module("scripts." + sys.argv[1])
try:
    code = mod.main.info.raw_f(*sys.argv[2:])
except SystemExit as exit:
    code = exit.code
if isinstance(code, str):
    print(code, file=sys.stderr)
    code = 1
sys.exit(code or 0)
"""


class DriveFailed(Exception):
    pass


@dataclass(frozen=True)
class Drive:
    proves: str
    paths: list[str]
    run: Callable[[Context], str]


@dataclass
class Context:
    run_dir: Path
    scratch: Path
    env: dict[str, str]
    drive_dir: Path = Path()

    def python(
        self, name: str, *args: str, expect_exit: int = 0, timeout: float = 45
    ) -> subprocess.CompletedProcess[str]:
        cmd = [str(PYTHON), *args]
        (self.drive_dir / f"{name}.cmd").write_text(" ".join(cmd) + "\n")
        proc = subprocess.Popen(
            cmd,
            cwd=ROOT,
            env=self.env,
            text=True,
            start_new_session=True,
            stdout=subprocess.PIPE,
            stderr=subprocess.PIPE,
        )
        try:
            out, err = proc.communicate(timeout=timeout)
        except subprocess.TimeoutExpired:
            os.killpg(proc.pid, signal.SIGKILL)
            proc.communicate()
            raise DriveFailed(f"{name} timed out after {timeout}s") from None
        with suppress(ProcessLookupError):
            os.killpg(proc.pid, signal.SIGKILL)  # reap anything the child left in its group
        for suffix, text in (("stdout", out), ("stderr", err), ("exit", f"{proc.returncode}\n")):
            (self.drive_dir / f"{name}.{suffix}").write_text(text)
        if proc.returncode != expect_exit:
            tail = (err or out).strip().splitlines()[-1:] or ["<no output>"]
            raise DriveFailed(
                f"{name}: expected exit {expect_exit}, got {proc.returncode}: {tail[0]}"
            )
        return subprocess.CompletedProcess(cmd, proc.returncode, out, err)

    def cli(self, name: str, *args: str, expect_exit: int = 0) -> dict[str, Any]:
        return json.loads(
            self.python(
                name, "-m", "esme_posttrain", *args, "--json", expect_exit=expect_exit
            ).stdout
        )


def require(condition: bool, message: str) -> None:
    if not condition:
        raise DriveFailed(message)


def train_losses(path: Path) -> list[float]:
    rows = [json.loads(line) for line in path.read_text().splitlines() if line.strip()]
    return [row["train/loss"] for row in rows if row.get("event") == "train"]


def drive_stage_chain(ctx: Context, *, max_sft_final_loss: float | None = None) -> str:
    out = ctx.drive_dir / "artifacts"
    report = ctx.cli(
        "full-path",
        "full-path-cpu-smoke",
        "--config",
        "fixtures/configs/full-path-cpu-smoke.json",
        "--output-dir",
        str(out),
    )
    require(report["status"] == "full_path_cpu_smoke_passed", f"status {report['status']!r}")
    require(
        report["steps"] == {"sft": 2, "dpo": 2, "rlvr": 2},
        f"steps {report['steps']}, expected 2 per stage",
    )
    require(
        not (
            report["paid_compute"] or report["remote_dataset_download"] or report["wandb_enabled"]
        ),
        "chain reports paid compute, downloads, or W&B",
    )
    require(
        report["dpo_resume"]["equivalent_to_uninterrupted"],
        "DPO resumed from step 1 does not match the uninterrupted run",
    )
    stages = {"sft": out / "sft", "dpo": out / "dpo-resumed", "rlvr": out / "rlvr"}
    losses = {stage: train_losses(path / "metrics.jsonl") for stage, path in stages.items()}
    require(
        all(len(v) == 2 and all(math.isfinite(x) for x in v) for v in losses.values()),
        f"expected 2 finite train losses per stage, got {losses}",
    )
    sft_first, sft_final = losses["sft"]
    ceiling = sft_first if max_sft_final_loss is None else max_sft_final_loss
    require(
        sft_final < ceiling,
        f"expected final SFT loss < {ceiling:.4f}, got {sft_final:.4f} (first {sft_first:.4f})",
    )
    require(losses["dpo"][1] < losses["dpo"][0], f"DPO loss did not fall: {losses['dpo']}")
    rebuilt = ctx.scratch / "rebuilt-bundle"
    ctx.cli(
        "rebuild",
        "rlvr-checkpoint-bundle",
        "--checkpoint",
        str(stages["rlvr"] / "checkpoints/step-000002/checkpoint.pt"),
        "--template-bundle",
        str(stages["rlvr"] / "bundle-final"),
        "--out",
        str(rebuilt),
        "--expected-step",
        "2",
    )
    for name, bundle in (
        ("dpo", out / "dpo-bundle"),
        ("rlvr", stages["rlvr"] / "bundle-final"),
        ("rebuilt", rebuilt),
    ):
        ctx.cli(f"bundle-check-{name}", "bundle-check", "--bundle-dir", str(bundle))
    same = (rebuilt / "weights.pt").read_bytes() == (
        stages["rlvr"] / "bundle-final/weights.pt"
    ).read_bytes()
    require(
        same,
        "bundle rebuilt from the step-2 GRPO checkpoint has different weights than the final RL bundle",
    )
    return (
        f"SFT->DPO->RL 2 steps each, SFT loss {sft_first:.3f}->{sft_final:.3f}, DPO {losses['dpo'][0]:.3f}->{losses['dpo'][1]:.3f}, "
        "DPO resume exact, step-2 checkpoint rebuilds the final bundle byte-for-byte, 3 bundles pass bundle-check"
    )


def drive_launch_plans(ctx: Context) -> str:
    jobs = ctx.scratch / "emit-jobs.json"
    jobs.write_text(
        json.dumps(
            [
                {
                    "label": "a",
                    "split": "heldout_fresh",
                    "n": 1,
                    "temperature": 0.0,
                    "max_new_tokens": 8,
                    "seed": 0,
                    "bundle": "/root/exports/b",
                }
            ]
        )
    )
    stages = {
        "sft": (
            "modal_chat_sft",
            ["--config", "configs/esme-214m-sft-multiturn.json"],
            ["--modal-smoke", "--modal-sweep", "--throughput-probe", "--full-run"],
        ),
        "dpo": (
            "modal_chat_dpo",
            ["--config", "configs/esme-214m-chat-dpo.json"],
            ["--modal-smoke", "--beta-sweep", "--chat-eval", "--full-run"],
        ),
        # The real fixture config: a refusal that writes a report changes the checkout and fails.
        "rlvr": (
            "modal_rlvr_grpo",
            ["--config", "fixtures/configs/esme-214m-rl.fixture.json"],
            ["--full-run", "--debug-before-eval", "--modal-pipeline-smoke"],
        ),
    }

    def check_stage(stage: str, script: str, config: list[str], launches: list[str]) -> None:
        plan = json.loads(
            ctx.python(
                f"{stage}-plan", "-c", ENTRYPOINT, script, *config, "--dry-run", "--json"
            ).stdout
        )
        require(
            plan["will_start_modal_job"] is False and plan["approval_flag"] == "--approved",
            f"{stage} dry-run would start Modal or lost its approval flag",
        )
        require(
            any("requires --approved" in b for b in plan["full_launch_blockers"]),
            f"{stage} plan blockers {plan['full_launch_blockers']} omit the approval gate",
        )
        for launch in launches:
            refused = ctx.python(
                f"{stage}{launch}", "-c", ENTRYPOINT, script, *config, launch, expect_exit=2
            )
            text = refused.stdout + refused.stderr
            gated = "refused" in text and any(
                f"{verb} --approved" in text for verb in ("requires", "pass")
            )
            require(
                gated,
                f"{stage} {launch} without --approved did not refuse at the approval gate: {text.strip()[:200]}",
            )

    def check_emit() -> None:
        emit = ctx.python(
            "emit-unapproved",
            "-c",
            ENTRYPOINT,
            "modal_emit_completions",
            str(jobs),
            str(ctx.scratch / "emit-out"),
            expect_exit=1,
        )
        require(
            "refused" in emit.stderr and "need --approved" in emit.stderr,
            f"emit-completions did not refuse: {emit.stderr.strip()[:200]}",
        )
        require(
            not (ctx.scratch / "emit-out").exists(), "emit-completions wrote output while refusing"
        )

    def check_script_dry_run(stage: str, script: str, config: list[str]) -> None:
        # Run the file the way a user does. The import shim above skips the module's
        # `__main__` path and its top-level code, where a direct run once crashed.
        plan = json.loads(
            ctx.python(
                f"{stage}-direct", f"scripts/{script}.py", *config, "--dry-run", "--json"
            ).stdout
        )
        require(
            plan["will_start_modal_job"] is False and plan["approval_flag"] == "--approved",
            f"{stage} direct dry-run would start Modal or lost its approval flag",
        )

    with (
        ThreadPoolExecutor() as pool
    ):  # each launcher is an independent process; run them side by side
        futures = (
            [pool.submit(check_stage, stage, *spec) for stage, spec in stages.items()]
            + [
                pool.submit(check_script_dry_run, stage, *spec[:2])
                for stage, spec in stages.items()
            ]
            + [pool.submit(check_emit)]
        )
    for future in futures:
        future.result()
    return "SFT, DPO, and RL plans resolve without Modal, also when run as scripts; every paid mode and emit-completions refuse without --approved"


DRIVES = {
    "stage-chain": Drive(
        "SFT, DPO, and RL train on CPU through full-path-cpu-smoke; checkpoints resume and rebuild bundles that pass bundle-check",
        [
            "src/esme_posttrain/*",
            "fixtures/*",
            "configs/esme-214m-sft-multiturn.json",
            "configs/esme-214m-chat-dpo.json",
        ],
        drive_stage_chain,
    ),
    "launch-plans": Drive(
        "Every paid Modal launcher resolves its dry-run plan and refuses smoke, full, and emit launches without --approved",
        [
            "scripts/modal_*.py",
            "src/esme_posttrain/launch/*",
            "src/esme_posttrain/*/launch*.py",
            "src/esme_posttrain/*/config.py",
            "configs/*",
            "fixtures/configs/*",
        ],
        drive_launch_plans,
    ),
}
SMOKE = "stage-chain"


# The control passes only when its drive fails on exactly this planted expectation.
CONTROL_FAILURE = "expected final SFT loss < 0.0100, got "


def control(ctx: Context) -> str:
    return drive_stage_chain(ctx, max_sft_final_loss=0.01)


def git(*args: str) -> str:
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    return subprocess.run(
        ["git", *args], cwd=ROOT, env=env, capture_output=True, text=True, check=False
    ).stdout.strip()


def digest(path: Path) -> str:
    return hashlib.sha256(path.read_bytes()).hexdigest() if path.is_file() else "absent"


def checkout_state() -> dict[str, str]:
    """HEAD, branch, git config and hooks, and every changed, untracked, or ignored path.

    Changed and untracked files compare by content; ignored files by size and mtime, because
    .venv holds too many files to hash. `.verify/` and `__pycache__/` are the only allowed writes.
    """
    env = {k: v for k, v in os.environ.items() if not k.startswith("GIT_")}
    status = ["git", "status", "--porcelain=v2", "--branch", "-z", "-uall", "--ignored"]
    listing = subprocess.run(status, cwd=ROOT, env=env, capture_output=True, check=True).stdout
    git_dir = (ROOT / git("rev-parse", "--git-common-dir")).resolve()
    state = {".git/config": digest(git_dir / "config")}
    state |= {f".git/hooks/{hook.name}": digest(hook) for hook in (git_dir / "hooks").glob("*")}
    entries = iter(os.fsdecode(listing).split("\0"))
    for entry in entries:
        if entry.startswith("# branch.oid ") or entry.startswith("# branch.head "):
            key, _, value = entry[2:].partition(" ")
            state[key] = value
            continue
        if not entry or entry.startswith("#"):
            continue
        kind = entry[0]
        fields = {"1": 8, "2": 9, "u": 10}.get(kind)
        path = entry[2:] if fields is None else entry.split(" ", fields)[fields]
        if kind == "2":
            next(entries)
        if path.startswith(".verify/") or "__pycache__" in path.split("/"):
            continue
        target = ROOT / path
        if kind == "!":
            if target.exists():
                info = target.stat()
                state[path] = f"ignored:{info.st_size}:{info.st_mtime_ns}"
        else:
            status_code = entry.split(" ", 2)[1] if fields else kind
            state[path] = f"{status_code}:{digest(target)}"
    return state


def unique_run_dir(stem: str) -> Path:
    runs = ROOT / ".verify/runs"
    runs.mkdir(parents=True, exist_ok=True)
    for attempt in range(1, 1000):
        candidate = runs / (stem if attempt == 1 else f"{stem}-{attempt}")
        try:
            candidate.mkdir()
        except FileExistsError:
            continue
        return candidate
    raise OSError(f"no free run directory for {stem} under {runs}")


def changed_files() -> set[str]:
    base = git("merge-base", "HEAD", "origin/main") or git("merge-base", "HEAD", "main")
    files = set(git("diff", "--name-only", base).splitlines()) if base else set()
    files |= set(git("diff", "--name-only", "HEAD").splitlines())
    return files | set(git("ls-files", "--others", "--exclude-standard").splitlines())


def select_changed() -> list[str]:
    files = changed_files()
    if any(fnmatch.fnmatch(f, glob) for f in files for glob in GLOBAL_PATHS):
        return list(DRIVES)
    picked = [
        name
        for name, d in DRIVES.items()
        if any(fnmatch.fnmatch(f, g) for f in files for g in d.paths)
    ]
    return picked or [SMOKE]


def closed_port() -> int:
    with socket.socket() as sock:
        sock.bind(("127.0.0.1", 0))
        return sock.getsockname()[1]


def isolated_env(scratch: Path) -> dict[str, str]:
    home, trip = scratch / "home", scratch / "tripwire"
    for path in (home, trip, scratch / "site"):
        path.mkdir(parents=True)
    log = scratch / "tripwire.log"
    for tool in TRIPWIRE_TOOLS:
        stub = trip / tool
        stub.write_text(f'#!/bin/sh\necho "{tool} $*" >> "{log}"\nexit 97\n')
        stub.chmod(0o755)
    (scratch / "site" / "sitecustomize.py").write_text(SITECUSTOMIZE)
    env = {
        k: v
        for k, v in os.environ.items()
        if not k.startswith(("GIT_", "MODAL_", "WANDB_", "HF_", "SFT_", "DPO_", "RLVR_", "ESME_"))
        and not any(s in k for s in SECRET_MARKERS)
    }
    env.update(
        {
            "HOME": str(home),
            "XDG_CONFIG_HOME": str(home / ".config"),
            "XDG_CACHE_HOME": str(home / ".cache"),
            "XDG_DATA_HOME": str(home / ".local/share"),
            "PATH": f"{trip}:{env.get('PATH', '')}",
            "PYTHONPATH": f"{scratch / 'site'}:{ROOT}",
            "PYTHONDONTWRITEBYTECODE": "1",
            "VERIFY_TRIPWIRE_LOG": str(log),
            "HF_HOME": str(home / "hf"),
            "HF_HUB_OFFLINE": "1",
            "HF_DATASETS_OFFLINE": "1",
            "TRANSFORMERS_OFFLINE": "1",
            "WANDB_MODE": "disabled",
            "WANDB_DIR": str(scratch / "wandb"),
            "MODAL_CONFIG_PATH": str(home / ".modal.toml"),
            "MODAL_SERVER_URL": f"http://127.0.0.1:{closed_port()}",
            "TORCHINDUCTOR_CACHE_DIR": str(scratch / "inductor"),
            # The RL launcher requires the env timeout to equal the fixture config's runtime.timeout_hours.
            "RLVR_TIMEOUT_HOURS": "1",
            "ESME_BASE_BUNDLE_LOCAL": str(scratch / "no-base-bundle"),
        }
    )
    return env


def preflight(env: dict[str, str]) -> None:
    require(PYTHON.exists(), f"{PYTHON} is missing; run `make install`")
    where = subprocess.run(
        [str(PYTHON), "-c", "import esme_posttrain; print(esme_posttrain.__file__)"],
        env=env,
        capture_output=True,
        text=True,
        check=False,
    ).stdout.strip()
    require(
        where == str(ROOT / "src/esme_posttrain/__init__.py"),
        f"esme_posttrain imports from {where!r}, not this checkout",
    )
    require(
        env["WANDB_MODE"] == "disabled"
        and env["HF_HUB_OFFLINE"] == "1"
        and "MODAL_TOKEN_ID" not in env,
        "external-effect switches are not off",
    )


def main(argv: list[str]) -> int:
    command = argv[0] if argv else ""
    if command == "list":
        print(
            "\n".join(
                f"{n:14} {d.proves}\n{'':14} paths: {', '.join(d.paths)}" for n, d in DRIVES.items()
            )
        )
        return 0
    unknown = [n for n in argv if n not in DRIVES] if command not in ("all", "control") else []
    if unknown:
        print(f"unknown drive(s) {unknown}; see `verify list`", file=sys.stderr)
        return 2
    names = {"all": list(DRIVES), "control": ["control"]}.get(command) or argv or select_changed()
    sha = git("rev-parse", "HEAD")
    dirty = bool(git("status", "--porcelain"))
    run_dir = unique_run_dir(
        f"{datetime.now(UTC):%Y%m%dT%H%M%S%fZ}-{sha[:7]}{'-dirty' if dirty else ''}"
    )
    before = checkout_state()
    changed: list[str] = []
    scratch = Path(tempfile.mkdtemp(prefix="verify-esme-posttrain-"))
    results, failed = [], False
    try:
        env = isolated_env(scratch)
        preflight(env)
        ctx = Context(run_dir, scratch, env)
        redacted = {
            k: "<redacted>" if any(s in k for s in SECRET_MARKERS) else v for k, v in env.items()
        }
        (run_dir / "env.json").write_text(json.dumps(redacted, indent=2, sort_keys=True))
        for name in names:
            ctx.drive_dir = run_dir / name
            ctx.drive_dir.mkdir()
            start = time.monotonic()
            try:
                detail = (control if name == "control" else DRIVES[name].run)(ctx)
                result = "PASS"
            except DriveFailed as error:
                detail, result = str(error), "FAIL"
            except Exception as error:
                detail, result = f"drive crashed: {type(error).__name__}: {error}", "FAIL"
            trip_log = scratch / "tripwire.log"
            if trip_log.exists() and trip_log.read_text().strip():
                shutil.copy(trip_log, ctx.drive_dir / "tripwire.log")
                detail, result = (
                    f"tripwire fired: {trip_log.read_text().strip().splitlines()[0]}",
                    "FAIL",
                )
                trip_log.unlink()
            seconds = round(time.monotonic() - start, 1)
            print(f"{result} {name} {seconds}s {detail}", flush=True)
            results.append({"drive": name, "result": result, "seconds": seconds, "detail": detail})
            failed |= result == "FAIL"
    except DriveFailed as error:
        print(f"FAIL preflight {error}", file=sys.stderr)
        results.append({"drive": "preflight", "result": "FAIL", "seconds": 0, "detail": str(error)})
        failed = True
    finally:
        shutil.rmtree(scratch, ignore_errors=True)
        after = checkout_state()
        changed = sorted(p for p in before.keys() | after.keys() if before.get(p) != after.get(p))
        if changed:
            print(f"FAIL checkout changed during the run: {', '.join(changed)}", flush=True)
        failed = failed or bool(changed) or not results
        summary = {
            "sha": sha,
            "dirty": dirty,
            "result": "FAIL" if failed else "PASS",
            "checkout_changed": changed,
            "drives": results,
        }
        (run_dir / "summary.json").write_text(json.dumps(summary, indent=2))
    print(f"evidence: {run_dir.relative_to(ROOT)}")
    if command == "control":
        failures = [str(r["detail"]) for r in results if r["result"] == "FAIL"]
        if not changed and len(failures) == 1 and failures[0].startswith(CONTROL_FAILURE):
            print("control: FAIL observed")
            return 0
        if failures:
            print(f"control: failed for another reason; expected {CONTROL_FAILURE!r}")
        else:
            print("control: expected FAIL, but the wrong expectation passed")
        return 1
    return 1 if failed else 0


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
